{
  "buildCommand": "npm run verify:kamino && npm run build",
  "functions": {
    "api/wgg-protection-prepare.ts": {
      "maxDuration": 60
    },
    "api/wgg-monitor.ts": {
      "maxDuration": 60
    },
    "api/wgg-telegram-link.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/wgg-monitor",
      "schedule": "0 21 * * 5"
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/"
    },
    {
      "source": "/app/:path*",
      "destination": "/"
    }
  ]
}
