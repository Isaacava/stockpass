# Public browser-safe values
VITE_REOWN_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TELEGRAM_BOT_USERNAME=

# Vercel server-side runtime values
# Browser Solana JSON-RPC calls use /api/solana-rpc, which reads this value server-side.
SOLANA_RPC_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Configure official xStock Solana mint addresses before granting holder badges.
# Never infer a mint from a ticker symbol.
VITE_AAPLX_MINT=
VITE_NVDAX_MINT=
VITE_TSLAX_MINT=
VITE_SPYX_MINT=
VITE_MSFTX_MINT=
VITE_METAX_MINT=
